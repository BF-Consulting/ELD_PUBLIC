{% extends 'base.html.twig' %}
{% block title %}{{pname}}{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{asset('vendors/datatables.net-bs4/css/dataTables.bootstrap4.min.css')}}">
    <link rel="stylesheet" href="{{asset('vendors/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css')}}">
    <link rel="stylesheet" href="{{asset('vendors/bootstrap-datepicker/css/bootstrap-datepicker.css')}}">
    <link rel="stylesheet" href="{{asset('vendors/chosen/chosen.min.css')}}">
{% endblock %}
{% block body %}
{{ include('partials/_flash_messages.html.twig') }}
<div class="animated fadeIn">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                </div>
                <div class="card-body card-block">
                    <div class="card-title">
                        <h3 class="text-center">Rechercher des resultats</h3>
                    </div>
                    <hr>
                    <form method='POST' enctype="multipart/form-data" id="upload_form_comparator">
                        <input type="hidden" name="token" value="{{ csrf_token('historiqueForm') }}" />
                        <div class="row form-group">
                            <div class="col-12 col-md-4">
                                <div class="col-12">
                                    <select data-placeholder="Gestionnaires" name="gestionnaires" class="standardSelect" tabindex="1">
                                        <option value=""></option>
                                        {% for user in users %}
                                            <option {% if data.gestionnaires is defined  %}{% if data.gestionnaires == user.id  %}selected{% endif %}{% endif %} value="{{user.id}}">{{user.name}}-{{user.surname}}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="col-2">
                                Du :
                                </div>
                                <div class="col-10">
                                    <div class="form-group">
                                        <div class="input-group date" id="reservationdate" data-target-input="nearest">
                                            <input type="text" value="{% if data.dateDebut is defined  %}{{data.dateDebut}}{% endif %}" class="form-control datetimepicker-input" name="dateDebut" data-target="#reservationdate"/>
                                            <div class="input-group-append" data-target="#reservationdate" data-toggle="datetimepicker">
                                                <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="col-2">
                                Au :
                                </div>
                                <div class="col-10">
                                    <div class="form-group">
                                        <div class="input-group date" id="reservationdate2" data-target-input="nearest">
                                            <input type="text" value="{% if data.dateFin is defined  %}{{data.dateFin}}{% endif %}" class="form-control datetimepicker-input" name="dateFin" data-target="#reservationdate2"/>
                                            <div class="input-group-append" data-target="#reservationdate2" data-toggle="datetimepicker">
                                                <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-12 col-md-3">
                                <div class="col-12">
                                    <select data-placeholder="Commercialisateurs" name="commercialisateurs" class="standardSelect" tabindex="1">
                                        <option value=""></option>
                                        {% for commercilisateur in commercilisateurs %}
                                            <option {% if data.commercialisateurs is defined  %}{% if data.commercialisateurs == commercilisateur.id  %}selected{% endif %}{% endif %} value="{{commercilisateur.id}}">{{commercilisateur.numFournisseur}}-{{commercilisateur.name}}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="col-12 col-md-3">
                                <div class="col-12">
                                    <select data-placeholder="Employeurs" name="employeurs" class="standardSelect" tabindex="1">
                                        <option value=""></option>
                                        {% for employeur in employeurs %}
                                            <option {% if data.employeurs is defined  %}{% if data.employeurs == employeur.id  %}selected{% endif %}{% endif %}   value="{{employeur.id}}">{{employeur.raisonsociale}}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="col-12 col-md-3">
                                <div class="col-12">
                                    <select data-placeholder="Type de population" name="type" class="standardSelect" tabindex="1">
                                        <option value=""></option>
                                        {% for typePopulation in typePopulations %}
                                            <option {% if data.type is defined  %}{% if data.type == typePopulation.id  %}selected{% endif %}{% endif %} value="{{typePopulation.id}}">{{typePopulation.libelle}}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="col-12 col-md-3">
                                <div class="col-12">
                                    <select data-placeholder="Département" name="departement" class="standardSelect" tabindex="1">
                                        <option value=""></option>
                                        {% for i in 1..99 %}
                                            <option {% if data.departement is defined  %}{% if data.departement == i  %}selected{% endif %}{% endif %} value="{{i}}">{{i}}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-12">
                                <button type="submit" class="btn btn-success btn-sm pull-right">
                                    <i class="fa fa-dot-circle-o"></i> Envoyer
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <form method='POST' action="{{path('app_generatePdfHistotiqueResult')}}" enctype="multipart/form-data">
                    <input type="hidden" value="{% if data.gestionnaires is defined  %}{{data.gestionnaires}}{% endif %}" name="gestionnaires" />
                    <input type="hidden" value="{% if data.dateDebut is defined  %}{{data.dateDebut}}{% endif %}" name="dateDebut" />
                    <input type="hidden" value="{% if data.dateFin is defined  %}{{data.dateFin}}{% endif %}" name="dateFin" />
                    <input type="hidden" value="{% if data.commercialisateurs is defined  %}{{data.commercialisateurs}}{% endif %}" name="commercialisateurs" />
                    <input type="hidden" value="{% if data.employeurs is defined  %}{{data.employeurs}}{% endif %}" name="employeurs" />
                    <input type="hidden" value="{% if data.type is defined  %}{{data.type}}{% endif %}" name="type" />
                    <input type="hidden" value="{% if data.departement is defined  %}{{data.departement}}{% endif %}" name="departement" />
                    <div class="card-header row no-margin-left-right">
                        <div class=" col-12 col-md-8">
                            <strong class="card-title">Résultat</strong>
                        </div>
                        <div class=" col-12 col-md-4 text-right">
                            <button type="submit" class="btn btn-success btn-sm">
                                <i class="fa fa-file-pdf-o"></i> Générer PDF 
                            </button>
                        </div>
                    </div>
                    <div class="card-body card-block">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th scope="col">Nom</th>
                                    <th scope="col">Prénom</th>
                                    <th scope="col">NNI</th>
                                    <th scope="col">Matricule</th>
                                    <th scope="col">Employeur</th>
                                    <th scope="col">Dernier employeur</th>
                                    <th scope="col">Début période conso</th>
                                    <th scope="col">Fin période conso</th>
                                    <th scope="col">Montant</th>
                                    <th scope="col">Taxe</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for rep in dataResult %}
                                    <tr>
                                        <td>{{rep.nom|raw}}</td>
                                        <td>{{rep.prenom|raw}}</td>
                                        <td>{{rep.nni|raw}}</td>
                                        <td>{{rep.matricule|raw}}</td>
                                        <td>{{rep.employeur|raw}}</td>
                                        <td>{{rep.dernierEmployeur|raw}}</td>
                                        <td>{{rep.debutPeriode|raw}}</td>
                                        <td>{{rep.finPeriode|raw}}</td>
                                        <td>{{rep.montant|raw}}</td>
                                        <td>{{rep.taxe|raw}}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block javascripts %}
    <script src="{{asset('vendors/datatables.net/js/jquery.dataTables.min.js')}}"></script>
    <script src="{{asset('vendors/datatables.net-bs4/js/dataTables.bootstrap4.min.js')}}"></script>
    <script src="{{asset('vendors/datatables.net-buttons/js/dataTables.buttons.min.js')}}"></script>
    <script src="{{asset('vendors/datatables.net-buttons-bs4/js/buttons.bootstrap4.min.js')}}"></script>
    <script src="{{asset('vendors/jszip/dist/jszip.min.js')}}"></script>
    <script src="{{asset('vendors/pdfmake/build/pdfmake.min.js')}}"></script>
    <script src="{{asset('vendors/pdfmake/build/vfs_fonts.js')}}"></script>
    <script src="{{asset('vendors/datatables.net-buttons/js/buttons.html5.min.js')}}"></script>
    <script src="{{asset('vendors/datatables.net-buttons/js/buttons.print.min.js')}}"></script>
    <script src="{{asset('vendors/datatables.net-buttons/js/buttons.colVis.min.js')}}"></script>
    <script src="{{asset('assets/js/init-scripts/data-table/datatables-init.js')}}"></script>
    <script src="{{asset('vendors/moment/moment.min.js')}}"></script>
    <script src="{{asset('vendors/bootstrap-datepicker/js/bootstrap-datepicker.js')}}"></script>
    <script src="{{asset('vendors/chosen/chosen.jquery.js')}}"></script>
    <script>
        jQuery(document).ready(function($) {
            $('#reservationdate').datepicker({
                format: 'yyyy-mm-dd'
            });
            $('#reservationdate2').datepicker({
                format: 'yyyy-mm-dd'
            });
            jQuery(".standardSelect").chosen({
                disable_search_threshold: 0,
                no_results_text: "Oops, aucun resultat!",
                width: "100%"
            });
        });
    </script>
{% endblock %}