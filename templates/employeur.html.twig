{% extends 'base.html.twig' %}
{% block title %}{{pname}}{% endblock %}
{% block body %}
{{ include('partials/_flash_messages.html.twig') }}
<div class="animated fadeIn">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                </div>
                <div class="card-body card-block">
                    <div class="card-title">
                        <h3 class="text-center">Ajouter un employeur </h3>
                    </div>
                    <hr>
                    <form method='POST' enctype="multipart/form-data">
                        <input type="hidden" name="token" value="{{ csrf_token('employeur') }}" />
                        <div class="row form-group">
                            <div class="col col-md-3">
                                <label for="siren" class="control-label mb-1">Siren</label>
                            </div>
                            <div class="col-12 col-md-5">
                                <input id="siren" name="siren" type="text" class="form-control" aria-invalid="false" placeholder="Siren" value="{% if employeur is defined %}{{employeur.siren}}{% endif %}">
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col col-md-3">
                                <label for="siret" class="control-label mb-1">Siret</label>
                            </div>
                            <div class="col-12 col-md-5">
                                <input id="siret" name="siret" type="text" class="form-control"  aria-invalid="false" placeholder="Siret" value="{% if employeur is defined %}{{employeur.siret}}{% endif %}">
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col col-md-3">
                                <label for="raison_sociale" class="control-label mb-1">Raison Sociale</label>
                            </div>
                            <div class="col-12 col-md-5">
                                <input id="raison_sociale" name="raison_sociale" type="text" class="form-control" required=""  aria-invalid="false" placeholder="Raison Sociale" value="{% if employeur is defined %}{{employeur.raisonsociale}}{% endif %}">
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col col-md-3">
                                <label for="libelle" class="control-label mb-1">Libelle</label>
                            </div>
                            <div class="col-12 col-md-5">
                                <input id="libelle" name="libelle" type="text" class="form-control"   aria-invalid="false" placeholder="Libelle" value="{% if employeur is defined %}{{employeur.libelle}}{% endif %}">
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col col-md-3">
                                <label for="adresse" class="control-label mb-1">Adresse</label>
                            </div>
                            <div class="col-12 col-md-5">
                                <input id="adresse" name="adresse" type="text" class="form-control" required=""   aria-invalid="false" placeholder="Adresse commercialisateur" value="{% if employeur is defined %}{{employeur.adresse}}{% endif %}">
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col col-md-3">
                                <label for="code_postal" class="control-label mb-1"></label>
                            </div>
                            <div class="col-12 col-md-5">
                                <input id="code_postal" name="code_postal" type="text" class="form-control" required=""   aria-invalid="false" placeholder="Code postal commercialisateur" value="{% if employeur is defined %}{{employeur.codePostal}}{% endif %}">
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col col-md-3">
                                <label for="ville" class="control-label mb-1"></label>
                            </div>
                            <div class="col-12 col-md-5">
                                <input id="ville" name="ville" type="text" class="form-control" required=""  aria-invalid="false" placeholder="Ville commercialisateur" value="{% if employeur is defined %}{{employeur.ville}}{% endif %}">
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col col-md-3"></div>
                            <div class="col-12 col-md-9">
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="fa fa-dot-circle-o"></i> Envoyer
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}