{% extends 'base.html.twig' %}
{% block title %}{{pname}}{% endblock %}
{% block body %}
{{ include('partials/_flash_messages.html.twig') }}
<div class="animated fadeIn">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                </div>
                <div class="card-body card-block">
                    <div class="card-title">
                        <h3 class="text-center">Ajouter un type de population </h3>
                    </div>
                    <hr>
                    <form method='POST' enctype="multipart/form-data">
                        <input type="hidden" name="token" value="{{ csrf_token('typePopulation') }}" />
                        <div class="row form-group">
                            <div class="col col-md-3">
                                <label for="libelle" class="control-label mb-1">Libellé</label>
                            </div>
                            <div class="col-12 col-md-5">
                                <input id="libelle" name="libelle" type="text" class="form-control" aria-invalid="false" placeholder="Libelle" value="{% if typePopulation is defined %}{{typePopulation.libelle}}{% endif %}">
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col col-md-3"></div>
                            <div class="col-12 col-md-9">
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="fa fa-dot-circle-o"></i> Envoyer
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}