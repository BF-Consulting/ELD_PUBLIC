{% extends 'base.html.twig' %}
{% block title %}{{pname}}{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{asset('vendors/chosen/chosen.min.css')}}">
{% endblock %}
{% block body %}
{{ include('partials/_flash_messages.html.twig') }}
<div class="animated fadeIn">
    <div class="row">
        <div class="col-lg-12">
            <div class="alert  alert-warning fade show text-center" id="spinner-load" role="alert" style="display: none;">
                Veuillez patienter pendant l'importation...
            </div>
            <div class="alert  alert-success fade show text-center" id="spinner-load-success" role="alert" style="display: none;">
                Import du fichier de base terminer!
            </div>
            <div class="alert  alert-danger fade show text-center" id="spinner-load-error-file" role="alert" style="display: none;">
                Uniquement les fichiers <b>Csv</b> et <b>Excel</b> sont acceptés
            </div>
            <div class="card">
                <div class="card-header">
                </div>
                <div class="card-body card-block">
                    <div class="card-title">
                        <h3 class="text-center">Uploder le fichier de base</h3>
                    </div>
                    <hr>
		            <div class="row col-12"  id="upload_area">
		              <form method="post" class="col-12" id="upload_form" enctype="multipart/form-data">
                        <div class="col-12" style="text-align: center;margin-bottom: 25px;">
		                  <input required type="file" name="file" id="csv_file" />
		                </div>
                        <div class="col-12" style="text-align: center;margin-bottom: 25px;">
                            <select required data-placeholder="Département" name="departement" class="standardSelect" tabindex="1">
                                <option value=""></option>
                                {% for i in 1..99 %}
                                    <option value="{{i}}">{{i}}</option>
                                {% endfor %}
                            </select>
		                </div>
		                <div class="text-center col-12 bouton-action" align="center">
		                  <input type="submit" name="upload_file" id="upload_file" class="btn btn-success" value="Soumettre" />
		                </div>
		              </form>
		            </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class=" col-12 text-center">
                        <div class="col-12 col-md-6">
                            <form method='POST' action="{{path('app_generateBaseFileExcel')}}" enctype="multipart/form-data">
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="fa fa-file-excel-o"></i> Exporter le fichier de base
                                </button>
                            </form>
                        </div>
                        <div class="col-12 col-md-6">
                            <form method='POST'  action="{{path('app_deleteBaseFile')}}" enctype="multipart/form-data">
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="fa fa-trash"></i> Supprimer le fichier de base
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block javascripts %}
    <script src="{{asset('assets/js/import.js')}}"></script>
    <script src="{{asset('vendors/chosen/chosen.jquery.js')}}"></script>
    <script>
        jQuery(document).ready(function() {
            jQuery(".standardSelect").chosen({
                disable_search_threshold: 0,
                no_results_text: "Oops, aucun resultat!",
                width: "10%"
            });
        });
    </script>
{% endblock %}