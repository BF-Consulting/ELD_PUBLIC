{% extends 'base.html.twig' %}
{% block title %}{{pname}}{% endblock %}
{% block stylesheets %}
{% endblock %}
{% block body %}
	<div class="animated fadeIn">
    	<div class="row">        
            <div class="col-lg-1 col-md-6"></div>              
            <div class="col-lg-2 col-md-6">
                <div class="card block-header-box">
                    <div class="card-body">
                        <div class="stat-widget-one">
                            <div class="stat-icon dib"><i class="ti-user text-success border-success"></i></div>
                            <div class="stat-content dib">
                                <div class="stat-text block-header-box-text">Gestionnaires</div>
                                <div class="stat-digit">{% if tEmployer %}{{tEmployer}}{% else %}0{% endif %}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>            
            <div class="col-lg-2 col-md-6">
                <div class="card block-header-box">
                    <div class="card-body">
                        <div class="stat-widget-one">
                            <div class="stat-icon dib"><i class="ti-user text-success border-success"></i></div>
                            <div class="stat-content dib">
                                <div class="stat-text block-header-box-text">Pensionnés</div>
                                <div class="stat-digit">{% if tPensionner %}{{tPensionner}}{% else %}0{% endif %}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>            
            <div class="col-lg-2 col-md-6">
                <div class="card block-header-box">
                    <div class="card-body">
                        <div class="stat-widget-one">
                            <div class="stat-icon dib"><i class="ti-user text-success border-success"></i></div>
                            <div class="stat-content dib">
                                <div class="stat-text block-header-box-text">Salariés</div>
                                <div class="stat-digit">{% if tPensionner %}{{tPensionner}}{% else %}0{% endif %}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>            
            <div class="col-lg-2 col-md-6">
                <div class="card block-header-box">
                    <div class="card-body">
                        <div class="stat-widget-one">
                            <div class="stat-icon dib"><i class="ti-user text-success border-success"></i></div>
                            <div class="stat-content dib">
                                <div class="stat-text block-header-box-text">Employeurs</div>
                                <div class="stat-digit">{{tEmployer}}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>       
            <div class="col-lg-2 col-md-6">
                <div class="card block-header-box">
                    <div class="card-body">
                        <div class="stat-widget-one">
                            <div class="stat-icon dib"><i class="ti-user text-success border-success"></i></div>
                            <div class="stat-content dib">
                                <div class="stat-text block-header-box-text">Commercialisateurs</div>
                                <div class="stat-digit">{{tCommercialisateurs}}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>       
            <div class="col-lg-1 col-md-6"></div>   
		</div>
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header text-center">
                        Dernniers résultats du comparateur
                    </div>
                    <div class="card-body">
                        <table id="bootstrap-data-table-export" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th >Nom</th>
                                    <th >Prénom</th>
                                    <th >NNI</th>
                                    <th >Matricule</th>
                                    <th>Employeur</th>
                                    <th>Dernier employeur</th>
                                    <th>Début période conso</th>
                                    <th>Fin période conso</th>
                                    <th>Montant</th>
                                    <th>Taxe</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for rep in resultatsComparateur %}
                                    <tr id="{{rep.id}}">
                                        <td>{{rep.nom|raw}}</td>
                                        <td>{{rep.prenom|raw}}</td>
                                        <td>{{rep.nni|raw}}</td>
                                        <td>{{rep.matricule|raw}}</td>
                                        <td>{{rep.employeur|raw}}</td>
                                        <td>{{rep.dernierEmployeur|raw}}</td>
                                        <td>{{rep.debutPeriode|raw}}</td>
                                        <td>{{rep.finPeriode|raw}}</td>
                                        <td>{{rep.montant|raw}}</td>
                                        <td>{{rep.taxe|raw}}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header text-center">
                        Dernniers Employeurs ajoutés
                    </div>
                    <div class="card-body">
                        <table id="bootstrap-data-table-export" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Raison Sociale</th>
                                    <th>Libellé</th>
                                    <th>Dépatement</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for employeur in employeurs %}
                                    <tr id="{{employeur.id}}">
                                        <td>{{employeur.raisonsociale}}</td>
                                        <td>{{employeur.libelle}}</td>
                                        <td>{{employeur.departement}}</td>
                                        <td>
                                            <div class="btn-group">
                                                <a href="{{path('app_update_employeur',{id:employeur.id})}}" type="button" class="btn btn-info btn-flat">Modifier</a>
                                                <button type="button" class="btn btn-info btn-flat dropdown-toggle dropdown-icon" data-toggle="dropdown">
                                                <span class="sr-only">Toggle Dropdown</span>
                                                </button>
                                                <div class="dropdown-menu" role="menu">
                                                    <a data-id="{{employeur.id}}" class="dropdown-item delete-user" href="#">Supprimer</a>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header text-center">
                        Dernniers commercialisateurs ajoutés
                    </div>
                    <div class="card-body">
                        <table id="bootstrap-data-table-export" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Libellé</th>
                                    <th>Code</th>
                                    <th>Dépatement</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for commercilisateur in commercilisateurs %}
                                    <tr id="{{commercilisateur.id}}">
                                        <td>{{commercilisateur.name}}</td>
                                        <td>{{commercilisateur.numFournisseur}}</td>
                                        <td>{{commercilisateur.departement}}</td>
                                        <td>
                                            <div class="btn-group">
                                                <a href="{{path('app_update_commercialisateur',{id:commercilisateur.id})}}" type="button" class="btn btn-info btn-flat">Modifier</a>
                                                <button type="button" class="btn btn-info btn-flat dropdown-toggle dropdown-icon" data-toggle="dropdown">
                                                <span class="sr-only">Toggle Dropdown</span>
                                                </button>
                                                <div class="dropdown-menu" role="menu">
                                                    <a data-id="{{commercilisateur.id}}" class="dropdown-item delete-user" href="#">Supprimer</a>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
	</div>
{% endblock %}
{% block javascripts %}
    <script src="{{asset('vendors/chart.js/dist/Chart.bundle.min.js')}}"></script>
    <script src="{{asset('assets/js/init-scripts/chart-js/chartjs-init.js')}}"></script>
{% endblock %}