{% extends 'base.html.twig' %}
{% block title %}{{pname}}{% endblock %}
{% block body %}
{{ include('partials/_flash_messages.html.twig') }}
<div class="animated fadeIn">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                </div>
                <div class="card-body card-block">
                    <div class="card-title">
                        <h3 class="text-center">Ajouter un utilisateur</h3>
                    </div>
                    <hr>
                    <form method='POST' enctype="multipart/form-data">
                        <input type="hidden" name="token" value="{{ csrf_token('user') }}" />
                        <div class="row form-group">
                            <div class="col col-md-3">
                                <label for="name" class="control-label mb-1"></label>
                            </div>
                            <div class="col-12 col-md-5">
                                <input id="name" name="name" type="text" class="form-control" required="true" aria-invalid="false" placeholder="Nom" value="{% if user is defined %}{{user.name}}{% endif %}">
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col col-md-3">
                                <label for="surname" class="control-label mb-1"></label>
                            </div>
                            <div class="col-12 col-md-5">
                                <input id="surname" name="surname" type="text" class="form-control"  aria-invalid="false" placeholder="Prénom" value="{% if user is defined %}{{user.surname}}{% endif %}">
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col col-md-3">
                                <label for="email" class="control-label mb-1"></label>
                            </div>
                            <div class="col-12 col-md-5">
                                <input id="email" name="email" type="email" class="form-control"  aria-invalid="false" placeholder="Email" value="{% if user is defined %}{{user.email}}{% endif %}">
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col col-md-3">
                                <label for="username" class="control-label mb-1"></label>
                            </div>
                            <div class="col-12 col-md-5">
                                <input id="username" name="username" type="text" class="form-control" required="true" aria-invalid="false" placeholder="NNI" value="{% if user is defined %}{{user.username}}{% endif %}">
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col col-md-3">
                                <label for="password" class="control-label mb-1"></label>
                            </div>
                            <div class="col-12 col-md-5">
                                <input id="password" name="password" type="text" class="form-control"  aria-invalid="false" placeholder="Mot de passe" value="">
                                <span class="help-block">Laisser vide si vous ne voulez pas modifier le mot de passe</span>
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col col-md-3"></div>
                            <div class="col-12 col-md-9">
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="fa fa-dot-circle-o"></i> Envoyer
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
